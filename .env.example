# ---------------------------------------------------------------------------
# TSM Atelier — environment template
#
# Copy to `.env.local` for local development:
#     cp .env.example .env.local
#
# For deployment (Vercel / Netlify), set these in the provider's environment
# settings UI. `.env.local` is gitignored and is never deployed.
# ---------------------------------------------------------------------------


# --- Server-only -----------------------------------------------------------
# Never prefix these with NEXT_PUBLIC_. Variables without that prefix stay on
# the server and are absent from the browser bundle.

# Origin of the Spring Boot REST API. Required — the app will not start without
# it, in development or in production.
#
# Two things read this single variable, so the halves of the app can never drift
# onto different backends: the `/api/:path*` rewrite in next.config.ts, which is
# how every browser request reaches Spring Boot, and the Server Components that
# fetch the catalog directly.
#
# In production this should ideally NOT be publicly routable: lock the backend
# down to accept traffic only from your Next.js deployment. That network
# isolation is the main security benefit the BFF exists to provide.
SPRING_BOOT_API_URL=http://localhost:8080


# --- Public ----------------------------------------------------------------
# NEXT_PUBLIC_* values are inlined into the client bundle at build time and are
# readable by anyone via view-source. Only put non-secret values here.

# Stripe publishable key. Safe to expose by design — use pk_test_* locally.
# The secret key belongs on the Spring Boot side and must never appear here.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_replace_me

# There is deliberately no variable for the browser-side API base URL.
#
# It is hardcoded to the relative `/api` in src/lib/api/client.ts, because the
# session depends on staying on one origin: the cookies are SameSite=Strict, so
# an absolute URL would stop them being sent while public requests kept working
# — the catalogue would look healthy and every signed-in action would fail.
# That is not a value worth making configurable.
